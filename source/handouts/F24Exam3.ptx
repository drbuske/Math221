   \draw [black!80,line width=0.3pt,-latex] (0,0) -- (0,-0.5);
\draw[color=linecolor, line width=1pt,domain=0.5:3.5]   plot (\x,{-1/32*(4*\x*\x)+1/2*(2*\x)+1/32}) node [above] at (1.65,2) {$\displaystyle f(x)$};
\fill [black] (0.5,2/4) circle(2pt);
\fill [black] (1.5,5/4) circle(2pt);
\fill [black] (2.5,7/4) circle(2pt);
\fill [black] (3.5,8/4) circle(2pt);
\foreach \x/\xtext in { 1/2, 2/4, 3/6, 4/8}
